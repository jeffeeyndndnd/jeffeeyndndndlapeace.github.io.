<!DOCTYPE html>
<html>
<head>
<title>Jeffrey's Arcade</title>
<style>
body {
  background: #101020;
  color: white;
  font-family: Arial;
  text-align: center;
}
h1 { color: #9b70ff; }
input {
  padding: 14px;
  width: 70%;
  border-radius: 12px;
}
.games {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20px;
  margin: 30px;
}
.game {
  background: #242447;
  padding: 25px;
  border-radius: 15px;
  width: 180px;
}
button {
  background: #8055ff;
  color: white;
  border: 0;
  padding: 12px;
  border-radius: 8px;
  cursor: pointer;
}
</style>
</head>
<body>

<h1>🎮 JEFFREY'S ARCADE</h1>
<h3>Welcome to your gaming world!</h3>

<input id="search" placeholder="Search games..."
oninput="searchGames()">

<div class="games">
  <div class="game">
    <h2>⚡ Clicker</h2>
    <p id="score">Score: 0</p>
    <button onclick="clickGame()">PLAY</button>
  </div>

  <div class="game">
    <h2>🚀 Space Game</h2>
    <p>Coming soon!</p>
  </div>

  <div class="game">
    <h2>🏎️ Racing</h2>
    <p>Coming soon!</p>
  </div>

  <div class="game">
    <h2>🧩 Puzzle</h2>
    <p>Coming soon!</p>
  </div>
</div>

<script>
let score = 0;

function clickGame() {
  score++;
  document.getElementById("score").innerText =
    "Score: " + score;
}

function searchGames() {
  let q = document.getElementById("search")
    .value.toLowerCase();

  document.querySelectorAll(".game").forEach(game => {
    game.style.display =
      game.innerText.toLowerCase().includes(q)
      ? "" : "none";
  });
}
</script>

</body>
</html>
